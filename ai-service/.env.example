# Argus Catalog AI Service 설정 예시 — Docker/네이티브 공통.
# (이전 이름 AGENT_* 도 한 버전 동안 읽지만 곧 없어진다)
# 우선순위: CLI 인자 > 환경변수 > 기본값

# 카탈로그 API — enrich 가 로그인하는 계정 (assistant 는 사용자 토큰을 위임받아 쓰지 않는다)
# 결과 반입 API 가 관리자 전용이라 관리자(argus-admin) 역할 계정이 필요하다.
# 개발 환경은 기본 admin 을 그대로 쓰고, 운영(RPM 설치)은 전용 서비스 계정 argus 를
# 사용자 관리에서 먼저 만들어 쓴다(release/components/ai-service/conf/ai-service.env 참고).
# 비밀번호 예시 값(changeme)은 반드시 바꾼다.
ARGUS_API_URL=http://localhost:4600
ARGUS_USERNAME=admin
ARGUS_PASSWORD=changeme

# LLM — OpenAI 호환 엔드포인트 (ollama 기본)
ARGUS_AI_LLM_URL=http://localhost:11434/v1
ARGUS_AI_MODEL=qwen2.5:7b
ARGUS_AI_LLM_API_KEY=ollama

# 동작: suggest(제안 — 사람 승인) | apply(직접 적용, PII 는 항상 제안)
ARGUS_AI_MODE=suggest
ARGUS_AI_TEMPERATURE=0.3
ARGUS_AI_MAX_TOKENS=2048

# enrich worker
ARGUS_AI_POLL_INTERVAL=300
ARGUS_AI_WORKER_TARGET=missing

# assistant 셀프-텔레메트리 — 카탈로그 AI Agent 레지스트리에 자신을 등록하고
# 채팅 호출 지표(지연·토큰·성공여부)를 push (베스트에포트). 레지스트리가 없는
# 환경이면 ARGUS_AI_TELEMETRY=off 로 끌 수 있다.
ARGUS_AI_AGENT_NAME=argus-catalog-assistant
ARGUS_AI_TELEMETRY=on
