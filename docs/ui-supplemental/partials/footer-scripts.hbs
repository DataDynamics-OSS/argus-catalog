<script id="site-script" src="{{{uiRootPath}}}/js/site.js" data-ui-root-path="{{{uiRootPath}}}"></script>
<script async src="{{{uiRootPath}}}/js/vendor/highlight.js"></script>
{{#if env.SITE_SEARCH_PROVIDER}}
{{> search-scripts}}
{{/if}}
<script>
  // 좌측 사이드바 nav 트리를 기본적으로 모두 펼친다.
  // Antora 기본 동작은 현재 페이지의 조상 항목만 펼치지만, 외부 고객 매뉴얼에서는
  // 전체 구조를 한눈에 보이게 하는 것이 유리. 클릭으로 접고 펴는 동작은 그대로 유지.
  (function () {
    var nav = document.querySelector('.nav-container [data-panel="menu"]');
    if (!nav) return;
    nav.querySelectorAll('.nav-item').forEach(function (item) {
      item.classList.add('is-active');
    });
  })();
</script>
<script>
  // 복잡한 도표도 원본 해상도로 읽을 수 있도록 기본 이미지 링크를 제공한다.
  (function () {
    document.querySelectorAll('.imageblock.diagram img').forEach(function (img) {
      if (img.closest('a')) return;
      var link = document.createElement('a');
      link.href = img.src;
      link.target = '_blank';
      link.rel = 'noopener';
      link.title = '그림을 원본 크기로 보기 (새 탭)';
      link.setAttribute('aria-label', img.alt + ' — 원본 크기로 보기 (새 탭)');
      img.parentNode.insertBefore(link, img);
      link.appendChild(img);
    });
  })();
</script>
