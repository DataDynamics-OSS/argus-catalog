# SPDX-License-Identifier: Apache-2.0
# Argus Catalog 컴포넌트 공용 RPM spec — release/scripts/build-in-container.sh 가 @값@ 을 채운다.
# 묶음 tar.gz 를 그대로 Source0 으로 쓰고, 파일 배치·설치 후 구성은 묶음의 install.sh 를 공유한다.

# 번들(venv 용 wheel, node 런타임)을 그대로 담는다 — 자동 의존성·strip·bytecompile·debuginfo 생략
%global debug_package %{nil}
%global __os_install_post %{nil}
%global __brp_check_rpaths %{nil}
%define _build_id_links none

Name:           @NAME@
Version:        @VERSION@
Release:        @RELEASE@
Summary:        @SUMMARY@
License:        Apache-2.0
URL:            https://github.com/DataDynamics/argus-catalog
Source0:        @NAME@-@VERSION@.tar.gz
BuildArch:      @ARCH@
AutoReqProv:    no
@REQUIRES@
Requires(pre):  shadow-utils
Requires(post): shadow-utils

%description
@DESCRIPTION@

%prep
%setup -q -n @NAME@-@VERSION@

%build

%install
./install.sh --layout-only --destdir %{buildroot} --unit-dir %{_unitdir}

%pre
getent group argus >/dev/null || groupadd -r argus
getent passwd argus >/dev/null || \
  useradd -r -g argus -d /var/lib/argus -s /sbin/nologin -c "Argus Catalog service account" argus
exit 0

%post
@PREFIX@/share/installer/install.sh --post-only -q
if [ "$1" -gt 1 ]; then
  : # 업그레이드 — 실행 중인 서비스는 %postun 에서 재시작
fi

%preun
if [ "$1" -eq 0 ]; then
  for u in @UNITS@; do systemctl --no-reload disable --now "$u" >/dev/null 2>&1 || :; done
fi

%postun
if [ "$1" -eq 0 ]; then
  rm -rf @PREFIX@/venv
  # venv(%post 에서 만든 파일)가 있어 RPM 이 지우지 못한 빈 디렉터리 정리
  [ -d @PREFIX@ ] && find @PREFIX@ -depth -type d -empty -delete 2>/dev/null || :
@POSTUN_ERASE@
  systemctl daemon-reload >/dev/null 2>&1 || :
else
  systemctl daemon-reload >/dev/null 2>&1 || :
  for u in @UNITS@; do systemctl try-restart "$u" >/dev/null 2>&1 || :; done
fi

%files
@PREFIX@
@FILES_EXTRA@

%changelog
* @CHANGELOG_DATE@ Argus Catalog <release@argus-catalog> - @VERSION@-@RELEASE@
- Argus Catalog @VERSION@ release
