# Argus Catalog Query Service 설정 — 변경 후: systemctl restart argus-catalog-query-service
# 카탈로그 DB (카탈로그 서버와 같은 DB)
ARGUS_DB_TYPE=postgresql
ARGUS_DB_HOST=127.0.0.1
ARGUS_DB_PORT=5432
ARGUS_DB_NAME=argus_catalog
ARGUS_DB_USER=argus
ARGUS_DB_PASSWORD=argus

# 수신 주소·포트
ARGUS_QS_HOST=0.0.0.0
ARGUS_QS_PORT=4620

# collector → 수집 엔드포인트 인증 토큰 (collector 설정과 같게. 비우면 인증 없음)
ARGUS_QS_COLLECTOR_TOKEN=
# 관리 API(/batch/run 등) 토큰
ARGUS_QS_API_TOKEN=

# lineage·관계 배치 (내장 스케줄러)
#ARGUS_QS_BATCH_ENABLED=true
#ARGUS_QS_BATCH_INTERVAL_MINUTES=10
#ARGUS_QS_STORE_QUERY_HISTORY=true

# Impala Cloudera Manager 폴러 (Java Agent 와 같은 Impala 에 함께 켜지 않는다)
#ARGUS_QS_IMPALA_CM_ENABLED=false
#ARGUS_QS_IMPALA_CM_HOST=cm.example.com
#ARGUS_QS_IMPALA_CM_PORT=7180
#ARGUS_QS_IMPALA_CM_USERNAME=admin
#ARGUS_QS_IMPALA_CM_PASSWORD=
#ARGUS_QS_IMPALA_CM_CLUSTER=cluster
#ARGUS_QS_IMPALA_CM_SERVICE=impala
#ARGUS_QS_IMPALA_CM_TLS=false
#ARGUS_QS_IMPALA_CM_DATASOURCE_ID=
