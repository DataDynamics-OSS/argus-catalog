# Argus Catalog Query Service — 쿼리 수집(collector 수신) + lineage/관계 배치 상시 서비스(:4620)
NAME=argus-catalog-query-service
SUMMARY="Argus Catalog Query Service (query collection, lineage/relationship batch)"
DESCRIPTION="Hive·Impala·Trino·StarRocks collector 가 보내는 쿼리 이벤트를 저장하고, lineage·조인 관계 배치를 내장 스케줄러로 실행하는 상시 서비스."
PREFIX=/opt/argus-catalog-query-service
CONF_DIR=/etc/argus-catalog-query-service
STATE_DIRS=
UNITS="argus-catalog-query-service.service"
PYTHON_VENV=yes
PIP_INSTALL="argus-catalog-query-service"
RPM_REQUIRES="python3.11 systemd"
NEXT_STEPS="다음 단계:
  1) 설정: /etc/argus-catalog-query-service/query-service.env (DB 접속·수집 토큰)
  2) 시작: systemctl enable --now argus-catalog-query-service
  3) 확인: curl -s http://127.0.0.1:4620/health
  4) 각 엔진 collector 의 전송 주소를 http://<이 서버>:4620 으로 지정"
