# Argus Catalog AI Service — AI 어시스턴트 서버(:8930) + 메타데이터 보강(enrich) 워커
NAME=argus-catalog-ai-service
SUMMARY="Argus Catalog AI Service (AI assistant server, metadata enrichment worker)"
DESCRIPTION="카탈로그 AI 어시스턴트의 tool-use 채팅 서버(assistant)와, LLM 으로 데이터셋 설명·요약·컬럼·태그·PII 를 생성하는 배치/워커(enrich). OpenAI 호환 LLM(ollama·vLLM 등)이 별도로 필요하다."
PREFIX=/opt/argus-catalog-ai-service
CONF_DIR=/etc/argus-catalog-ai-service
STATE_DIRS=
UNITS="argus-catalog-ai-assistant.service argus-catalog-ai-enrich.service"
PYTHON_VENV=yes
PIP_INSTALL="argus-catalog-ai-service"
RPM_REQUIRES="python3.11 systemd"
LINKS="argus-catalog-ai"
NEXT_STEPS="다음 단계:
  1) 설정: /etc/argus-catalog-ai-service/ai-service.env (카탈로그 API·LLM 주소)
  2) 어시스턴트: systemctl enable --now argus-catalog-ai-assistant
     확인: curl -s http://127.0.0.1:8930/health
     카탈로그 설정 › AI 어시스턴트 에서 URL http://<이 서버>:8930 지정
  3) (선택) 보강 워커: ARGUS_AI_DATASOURCE_ID·계정 지정 후 systemctl enable --now argus-catalog-ai-enrich
  4) 1회 실행: argus-catalog-ai enrich all --datasource-id <ID>  (도움말: argus-catalog-ai --help)"
