# Argus Catalog AI Service 설정 — assistant·enrich 서비스 공용 (KEY=VALUE, 따옴표 없이)
# 우선순위: 명령 인자 > 이 파일(환경변수) > 기본값

# 카탈로그 API
#   assistant 는 채팅한 사용자의 토큰을 위임받아 도구를 호출하므로 아래 계정을 쓰지 않는다.
#   enrich(1회 실행·상시 워커)는 아래 서비스 계정으로 로그인해 데이터셋·샘플·용어를 읽고
#   결과를 반입(POST /api/v1/ai/datasets/{id}/suggestions/import — 관리자 전용)한다.
#   ARGUS_AI_MODE=apply 면 데이터셋 설명도 직접 수정한다.
#
#   ※ 이 계정은 카탈로그에 미리 만들어야 한다 — 관리 → 사용자 관리 → 작업 → 추가 에서
#     사용자명 argus, 역할 "관리자"(argus-admin) 로 만든다(반입 API 가 관리자만 허용).
#     비밀번호는 ARGUS_PASSWORD 에 적는다. 예시 값을 그대로 두지 말고 운영에서 반드시 바꾼다.
#     (관리자가 화면에서 비밀번호를 재설정하면 임시 비밀번호가 되어 다음 로그인 때 변경을
#      요구하므로, 한 번 화면으로 로그인해 바꾼 값을 여기에 적는다)
ARGUS_API_URL=http://127.0.0.1:4600
ARGUS_USERNAME=argus
ARGUS_PASSWORD=

# LLM — OpenAI 호환 엔드포인트 (ollama: http://<호스트>:11434/v1, vLLM: http://<호스트>:8000/v1)
ARGUS_AI_LLM_URL=http://127.0.0.1:11434/v1
ARGUS_AI_MODEL=qwen2.5:7b
ARGUS_AI_LLM_API_KEY=

# enrich 결과 적용 방식: suggest(제안 — 사람 승인) | apply(직접 적용, PII 는 항상 제안)
ARGUS_AI_MODE=suggest
ARGUS_AI_TEMPERATURE=0.3
ARGUS_AI_MAX_TOKENS=2048

# enrich 워커(argus-catalog-ai-enrich) — 대상 데이터 소스 ID 와 폴링 주기(초)
ARGUS_AI_DATASOURCE_ID=
ARGUS_AI_POLL_INTERVAL=300
ARGUS_AI_WORKER_TARGET=missing

# assistant 셀프-텔레메트리 — 카탈로그 AI Agent 레지스트리에 자신을 등록하고 호출 지표를 보낸다
ARGUS_AI_AGENT_NAME=argus-catalog-assistant
ARGUS_AI_TELEMETRY=on

# assistant 포트 (방화벽 개방 필요)
ARGUS_AI_PORT=8930
