# Argus Catalog SDK / CLI — argus-model, argus-catalog 명령 (모델 등록·AI 에이전트 매니페스트)
NAME=argus-catalog-sdk
SUMMARY="Argus Catalog Python SDK and CLI (argus-model, argus-catalog)"
DESCRIPTION="Argus Catalog Python SDK 와 CLI. 학습·배포 서버(Airflow 워커 등)에서 모델 등록과 AI 에이전트 매니페스트 반영에 쓴다."
PREFIX=/opt/argus-catalog-sdk
CONF_DIR=
STATE_DIRS=
UNITS=
PYTHON_VENV=yes
PIP_INSTALL="argus-catalog-sdk"
LINKS="argus-model argus-catalog"
RPM_REQUIRES="python3.11"
NEXT_STEPS="다음 단계:
  argus-model --help
  카탈로그 주소·인증: 환경변수 ARGUS_SERVER(기본 http://localhost:4600), ARGUS_TOKEN 또는 ARGUS_USERNAME/ARGUS_PASSWORD"
