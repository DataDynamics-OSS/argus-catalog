[Unit]
Description=Argus Catalog change-management worker (Temporal)
Documentation=file:///opt/argus-catalog-server/share/installer/README-INSTALL.md
After=network-online.target argus-catalog-server.service
Wants=network-online.target

[Service]
Type=simple
User=argus
Group=argus
WorkingDirectory=/opt/argus-catalog-server
Environment=ARGUS_CATALOG_SERVER_CONFIG_DIR=/etc/argus-catalog-server
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/argus-catalog-server
EnvironmentFile=-/etc/sysconfig/argus-catalog-server
# temporal.enabled=true 와 Temporal 서버(temporal.target)가 필요하다
ExecStart=/opt/argus-catalog-server/venv/bin/python -m app.change_mgmt.worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
