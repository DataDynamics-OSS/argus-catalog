# Argus Catalog Server 애드온 — 로컬 임베딩(sentence-transformers + CPU torch)
NAME=argus-catalog-server-embedding
SUMMARY="Argus Catalog Server add-on: local embedding (sentence-transformers, CPU torch)"
DESCRIPTION="임베딩 제공자 'local' 용 sentence-transformers·transformers·CPU 전용 torch 를 본체 venv 에 오프라인 설치한다. 외부(OpenAI 호환·Ollama) 임베딩만 쓰면 필요 없다."
PREFIX=/opt/argus-catalog-server/addons/embedding
ADDON_OF_PREFIX=/opt/argus-catalog-server
CONF_DIR=
STATE_DIRS=
UNITS=
PYTHON_VENV=yes
RPM_REQUIRES="argus-catalog-server = @VERSION@"
NEXT_STEPS="다음 단계:
  1) 서버 재시작: systemctl restart argus-catalog-server
  2) 폐쇄망이면 임베딩 모델을 미리 받아 두어야 한다 — README-INSTALL.md 의 '로컬 임베딩 모델' 참고"
