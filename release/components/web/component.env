# Argus Catalog Web UI — Next.js standalone + 내장 Node.js 런타임
NAME=argus-catalog-web
SUMMARY="Argus Catalog Web UI (Next.js standalone, bundled Node.js runtime)"
DESCRIPTION="Argus Catalog 웹 UI. Node.js 런타임을 포함하므로 OS 의 nodejs 패키지가 필요 없다. /api/v1 요청은 API_BASE_URL 의 카탈로그 서버로 프록시한다."
PREFIX=/opt/argus-catalog-web
CONF_DIR=/etc/argus-catalog-web
STATE_DIRS=
UNITS="argus-catalog-web.service"
PYTHON_VENV=no
RPM_REQUIRES="systemd"
NEXT_STEPS="다음 단계:
  1) 설정: /etc/argus-catalog-web/web.env 의 API_BASE_URL(카탈로그 서버 주소)·PORT 확인
  2) 시작: systemctl enable --now argus-catalog-web
  3) 확인: curl -sI http://127.0.0.1:3000/login"
